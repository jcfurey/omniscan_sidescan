<launch>
  <!-- Start omniscan sonars -->
  <include file="$(find omniscan_sidescan)/launch/sidescansonarall.launch" />

  <!-- Start ping echosounder -->
  <include file="$(find ping_sonar)/launch/echosounder.launch" />

  <!-- Start logger -->
  <include file="$(find omniscan_sidescan)/launch/logger.launch" />

</launch>
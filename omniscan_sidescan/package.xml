<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>omniscan_sidescan</name>
  <version>1.0.0</version>
  <description>ROS 2 driver for the Cerulean Omniscan 450 side scan sonar.</description>

  <maintainer email="mrozner1@binghamton.edu">Monika Roznere</maintainer>
  <author email="mrozner1@binghamton.edu">Monika Roznere</author>

  <license>MIT</license>

  <depend>omniscan_sidescan_msgs</depend>
  <depend>rclpy</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
